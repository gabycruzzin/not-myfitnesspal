# Copy this file to .env.local and fill in your Supabase project's values. .env.local is not committed.
# Both are under the dashboard's "Connect" button, or Project Settings → API Keys / Data API.
# The URL is https://<project ID>.supabase.co, where the project ID is in the dashboard's address bar.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
